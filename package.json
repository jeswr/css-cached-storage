{
  "name": "@jeswr/css-cached-storage",
  "version": "0.2.0-alpha.1",
  "description": "A Community Solid Server DataAccessor that puts an in-memory read cache and write-back queue in front of another DataAccessor.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Jesse Wright <https://github.com/jeswr>",
  "repository": {
    "type": "git",
    "url": "https://github.com/jeswr/css-cached-storage.git"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "lsd:module": "https://linkedsoftwaredependencies.org/bundles/npm/@jeswr/css-cached-storage",
  "lsd:components": "dist/components/components.jsonld",
  "lsd:contexts": {
    "https://linkedsoftwaredependencies.org/bundles/npm/@jeswr/css-cached-storage/^0.0.0/components/context.jsonld": "dist/components/context.jsonld"
  },
  "lsd:importPaths": {
    "https://linkedsoftwaredependencies.org/bundles/npm/@jeswr/css-cached-storage/^0.0.0/components/": "dist/components/",
    "https://linkedsoftwaredependencies.org/bundles/npm/@jeswr/css-cached-storage/^0.0.0/config/": "config/",
    "https://linkedsoftwaredependencies.org/bundles/npm/@jeswr/css-cached-storage/^0.0.0/dist/": "dist/"
  },
  "files": [
    "config",
    "dist"
  ],
  "scripts": {
    "build": "npm run build:ts && npm run build:components",
    "build:ts": "tsc",
    "build:components": "componentsjs-generator -s src -c dist/components -r ccs -i .componentsignore",
    "lint": "biome check src test",
    "lint:fix": "biome check --write src test",
    "test": "jest",
    "test:unit": "jest test/unit",
    "test:integration": "jest test/integration",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "lru-cache": "^11.0.0"
  },
  "peerDependencies": {
    "@solid/community-server": "^7.0.0 || 7.1.10-alpha.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@solid/community-server": "^7.1.9",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "componentsjs-generator": "3.1.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
