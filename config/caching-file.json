{
  "@context": [
    "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server/^7.0.0/components/context.jsonld",
    "https://linkedsoftwaredependencies.org/bundles/npm/@jeswr/css-cached-storage/^0.0.0/components/context.jsonld"
  ],
  "import": [
    "css:config/storage/backend/data-accessors/file.json"
  ],
  "@graph": [
    {
      "comment": "An in-memory read cache + write-back queue in front of the file-system DataAccessor. Point the backend store's `accessor` at urn:solid-server:default:CachedDataAccessor to use it.",
      "@id": "urn:solid-server:default:CachedDataAccessor",
      "@type": "CachingDataAccessor",
      "source": { "@id": "urn:solid-server:default:FileDataAccessor" },
      "maxReadCacheSize": 104857600,
      "maxReadFileSize": 10485760,
      "maxWriteQueueSize": 104857600,
      "maxWriteQueueFileSize": 10485760,
      "flushIntervalMs": 5000
    }
  ]
}
